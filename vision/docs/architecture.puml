@startuml
!theme plain
skinparam componentStyle uml2

package "Agentic System" {
  [Agentic Core\nbackend/core/perceive.py] as Agentic
}

package "Vision Service (FastAPI)" {
  [API (src/api.py)\nEndpoints: /vision/start, /vision/capture, /vision/stop] as API

  [Session Manager] as Session
  [Capture\nsrc/capture/webcam_capture.py] as Capture
  [Change Detector] as Change
  [Preprocessing\nsrc/preprocessing/preprocess.py] as Preproc
  [Detection (YOLO)\nsrc/detection/yolo_detect.py] as Detect
  [Interpretation + OCR\nsrc/interpretation/extract_state2.py] as Interpret
  [Data Storage\nvision/data/sessions/...] as Storage
  [Models\nYOLO weights, Tesseract, EasyOCR] as Models
}

Agentic -> API : POST /vision/start
API -> Session : create session
API -> Capture : start stream (camera 0)
Capture -> Change : frame stream
Change -> Storage : write raw_frames when changed
API -> Session : stop session (on /vision/stop)
API -> Preproc : preprocess(raw_frames -> preprocessed_frames)
Preproc -> Detect : preprocessed_frames
Detect -> Storage : detected_images + detected_csvs
Detect -> Interpret : CSVs + raw frames
Interpret -> Storage : final_output/vision_data.json
API -> Agentic : return JSON on /vision/stop

Models --> Detect
Models --> Interpret
Storage --> API

@enduml